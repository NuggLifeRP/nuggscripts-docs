---
import '../styles/brand.css';
import '../styles/pages.css';
import { getCollection } from 'astro:content';
import { SITE, SITE_URL } from '../../site.config.mjs';
import { storeData, products, kinds } from '../lib/catalog';
import logoMark from '../assets/logo-mark.png';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image?: string;
  active?: 'home' | 'store' | 'docs';
  intro?: boolean;
}
const { title, description, image, active, intro = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = image ?? `${SITE_URL}/og-default.jpg`;
const mark = await getImage({ src: logoMark, width: 96, format: 'png' });

const docs = (await getCollection('docs'))
  .filter((d) => !d.id.startsWith('404'))
  .map((d) => {
    const path = d.id === 'index' ? '' : d.id.replace(/\/index$/, '').replace(/^index$/, '');
    return { t: d.data.title, s: d.data.description ?? '', href: `/${path}${path ? '/' : ''}`, k: 'Docs' };
  });
const index = [
  ...products.map((p) => ({ t: p.short, s: p.pitch, href: p.href, k: p.kind === 'bundle' ? 'Bundle' : p.kind.toUpperCase(), img: p.image })),
  ...docs,
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>try{if(localStorage.getItem('ns-motion')==='off')document.documentElement.classList.add('motion-off')}catch(e){}</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#020906" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NuggScripts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://headless.tebex.io" crossorigin />
    <link rel="preconnect" href="https://dunb17ur4ymx4.cloudfront.net" />
    <slot name="head" />
  </head>
  <body class="ns">
    {intro && (
      <div class="lights" aria-hidden="true">
        <div class="rig">{[0, 1, 2, 3, 4].map(() => <div class="pod"><span class="lamp" /><span class="lamp" /></div>)}</div>
        <button class="skip" type="button">Skip</button>
      </div>
    )}
    <canvas id="ns-field" aria-hidden="true"></canvas>
    <div class="ns-grid" aria-hidden="true"></div>
    <div class="ns-grain" aria-hidden="true"></div>
    <div class="ns-halo" aria-hidden="true"></div>
    <div id="ns-progress" aria-hidden="true"></div>

    <a class="sr-only" href="#main">Skip to content</a>

    <header class="ns-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="NuggScripts home">
          <img src={mark.src} alt="" width="40" height="40" />
          <span>Nugg<b>Scripts</b></span>
        </a>
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <nav class="nav" aria-label="Main">
          <a href="/store/" aria-current={active === 'store' ? 'page' : undefined}>Store</a>
          {kinds.map((k) => <a href={`/store/#${k.key}`}>{k.plural}</a>)}
          <a href="/docs/" aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
          <a href={SITE.discord} target="_blank" rel="noopener noreferrer">Discord</a>
          <button class="navbtn" type="button" data-palette>Search<span class="kbd">Ctrl K</span></button>
        </nav>
        <button class="cart-btn" type="button" aria-label="Open cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.5L21 8H6" /><circle cx="10" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" /></svg>
          <span class="count">0</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ns-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <a class="brand" href="/"><img src={mark.src} alt="" width="40" height="40" /><span>Nugg<b>Scripts</b></span></a>
            <p style="color:var(--muted);font-size:14px;max-width:38ch;margin:14px 0 0">FiveM scripts, MLOs and props built for a live roleplay server first, then released. Delivered to your Cfx.re account through Tebex.</p>
          </div>
          <div>
            <h4>Store</h4>
            <ul>
              <li><a href="/store/">Everything</a></li>
              {kinds.map((k) => <li><a href={`/store/#${k.key}`}>{k.plural}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Help</h4>
            <ul>
              <li><a href="/docs/">Documentation</a></li>
              <li><a href="/start/downloading/">Downloading your purchase</a></li>
              <li><a href="/start/common-mistakes/">Common install mistakes</a></li>
              <li><a href="/start/support/">Getting support</a></li>
            </ul>
          </div>
          <div>
            <h4>Elsewhere</h4>
            <ul>
              <li><a href={SITE.discord} target="_blank" rel="noopener noreferrer">Discord</a></li>
              <li><a href={`https://github.com/${SITE.githubUser}`} target="_blank" rel="noopener noreferrer">GitHub</a></li>
              <li><a href={SITE.store} target="_blank" rel="noopener noreferrer">Tebex store</a></li>
            </ul>
          </div>
        </div>
        <div class="fine">
          <span>© {year} NuggScripts. Payments, tax and delivery are handled by Tebex, the merchant of record.</span>
          <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true">Animations: <span class="state">On</span></button>
          <span>Log in with the Cfx.re account that owns your server key. Not affiliated with Rockstar Games, Take-Two Interactive or Cfx.re.</span>
        </div>
      </div>
    </footer>

    <div class="scrim" id="ns-scrim"></div>
    <aside class="drawer" id="ns-drawer" aria-hidden="true" aria-label="Cart" role="dialog">
      <header>
        <h2 class="display">Your <span class="gtext">cart</span></h2>
        <button class="x" type="button" aria-label="Close cart"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </header>
      <div class="lines"></div>
      <footer>
        <div class="tot"><span style="color:var(--muted)">Total</span><span class="price">$0.00</span></div>
        <div class="who" hidden></div>
        <button class="btn btn-primary btn-block" type="button" data-checkout disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          <span class="lbl">Log in with FiveM & checkout</span>
        </button>
        <div class="err" role="alert"></div>
        <p style="margin:0;color:var(--muted);font-size:12px">Secure checkout by Tebex. Tax is calculated at payment. Assets arrive in your Cfx.re granted assets.</p>
      </footer>
    </aside>

    <div class="toast" id="ns-toast" role="status" aria-live="polite"></div>

    <div class="lightbox" id="ns-lightbox" aria-hidden="true" role="dialog" aria-label="Screenshot viewer">
      <img alt="" />
      <button class="nav-l" type="button" aria-label="Previous"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6" /></svg></button>
      <button class="nav-r" type="button" aria-label="Next"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></button>
      <button class="close" type="button" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      <span class="count"></span>
    </div>

    <div class="palette" id="ns-palette" role="dialog" aria-label="Search">
      <div class="box">
        <input type="search" placeholder="Search products and documentation…" aria-label="Search" />
        <ul></ul>
        <div class="hint"><span>↑ ↓ to move</span><span>Enter to open</span><span>Esc to close</span></div>
      </div>
    </div>

    <script type="application/json" id="ns-catalog" set:html={JSON.stringify(storeData())} />
    <script type="application/json" id="ns-index" set:html={JSON.stringify(index)} />
    <script>
      import { aurora, chrome, reveal, splitText, tilt, magnetic, countUp, startLights, motionToggle } from '../scripts/fx';
      import { initUI } from '../scripts/ui';
      startLights();
      const field = document.getElementById('ns-field') as HTMLCanvasElement | null;
      if (field) aurora(field);
      chrome();
      splitText();
      reveal();
      tilt();
      magnetic();
      countUp();
      initUI();
      motionToggle();
    </script>
  </body>
</html>
